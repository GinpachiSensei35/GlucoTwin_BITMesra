---
title: GlucoTwin — Digital Twin for Type 2 Diabetes (all data synthetic)
---
flowchart TB
    subgraph SRC["1 · Data sources (synthetic)"]
        SY["Synthea sample EHR<br/>1,171 patients · CSV"]
    end

    subgraph EHR["2 · src/ehr"]
        EB["build.py<br/>adults with T2D / prediabetes<br/>age, sex, BMI, HbA1c, lipids,<br/>hypertension, metformin"]
        PP[("patients.parquet<br/>238 patients")]
    end

    subgraph SIM["3 · src/wearable — physiological simulator"]
        GI["generate_inputs()<br/>Indian carb-heavy meals,<br/>steps, sleep"]
        SG["simulate_glucose()<br/>eAG from HbA1c · meal curves ×<br/>insulin resistance · exercise ·<br/>sleep · metformin · CGM noise"]
        WP[("wearables.parquet<br/>14 days × 5 min<br/>CGM, HR, steps, meals, sleep")]
    end

    subgraph FEAT["4 · src/features"]
        FB["make_features()<br/>lags, trends, rolling stats,<br/>carbs, steps, HR, sleep,<br/>time of day + static EHR<br/>label: max glucose in next 2 h > 180"]
        FP[("features.parquet<br/>948k rows · 32 features")]
    end

    subgraph ML["5 · src/model"]
        TR["train.py<br/>LightGBM · split by patient<br/>vs naive baseline"]
        EX["SHAP explanations<br/>→ plain-English reasons"]
        MJ[("model.joblib<br/>metrics.json")]
    end

    subgraph TWIN["6 · src/twin — what-if"]
        WI["what_if()<br/>edit meal carbs · post-meal walk ·<br/>last night's sleep → re-simulate 2 h<br/>Monte Carlo spike probability +<br/>ML risk curve"]
    end

    subgraph APP["7 · Serving"]
        API["FastAPI · api/<br/>/patients · /patients/{id}<br/>/predict · /whatif"]
        DB["Streamlit dashboard<br/>risk-sorted patient list ·<br/>EHR card · 24 h CGM + risk band ·<br/>top-3 reasons · what-if sliders"]
        DOC(["Clinician"])
    end

    SY --> EB --> PP
    PP --> GI --> SG --> WP
    PP --> SG
    PP --> FB
    WP --> FB --> FP --> TR --> MJ
    TR --> EX
    PP --> WI
    SG -. "reuses simulator + features" .-> WI
    MJ --> WI
    MJ --> API
    EX --> API
    WI --> API
    API --> DB --> DOC
    DOC -. "what-if scenario" .-> DB

